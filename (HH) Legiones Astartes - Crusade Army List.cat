              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Assault 1, Rending, Line of Effect</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="65ce-da42-1c9f-6768" name="Line of Effect" publicationId="ca571888--pubN113187" page="69" hidden="false">
              <description>Draw a line from Vulkan 1mm wide and 18" long to determine the weapons area of effect. All units crossed by the line suffer a number of hits equal to the number of models the line crosses.  May not be drawn over friendly models.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="a06f-7d38-d67f-0889" name="Rending" hidden="false" targetId="8269-2cd6-9236-16e7" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
