      </constraints>
      <profiles>
        <profile id="97fc-f70e-b1b6-4cd0" name="Kaedes Nex" publicationId="ca571888--pubN113187" page="110" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">5</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">6</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">4</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">4</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">2</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">6</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">3</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">9</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9ad5-ef26-2e82-f4a2" name="Relentless Stalker" publicationId="ca571888--pubN113187" page="110" hidden="false">
          <description>During deployment, select on enemy Elite or HQ choice as Kaedes Nex's chosen prey.  Instead of deploying normally, Nex may be placed after all other infiltrators anywhere within 18" of his chosen target as long as he remains out of sight of all enemy units, gaining Shrouded for the first turn of play.</description>
        </rule>
        <rule id="53d5-e94d-07b6-0037" name="The Raven's Vengeance" publicationId="ca571888--pubN113187" page="110" hidden="false">
          <description>When in combat with his chosen prey, Nex gains the Zealot rule.  If the unit is destroyed in close combat where Kaedes Nex is involved, or during a shooting phase in which he inflicted one or more wounds on the unit, an additional VP is scored for the Raven Guard.</description>
        </rule>
        <rule id="e589-958e-1192-e971" name="Ill-omened" publicationId="ca571888--pubN113187" page="110" hidden="false">
          <description>May not be chosen as an army's compulsory HQ and may may not be the warlord.  May not join units of any kind during deployment or during the game.</description>
        </rule>
        <rule id="541f-2ae9-92d1-d124" name="Gunfighter" publicationId="ca571888--pubN113187" page="110" hidden="false">
          <description>May use his Fulcrum hand-cannons profile in close combat.  He gains 1 attack for having two close-combat weapons.</description>
        </rule>
      </rules>
      <infoLinks>
