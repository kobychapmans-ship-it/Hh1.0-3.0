        <cost name="pts" typeId="points" value="15.0" />
      </costs>
    </selectionEntry>
    <selectionEntry id="ecb9-1c8a-b59c-df59" name="Thunderhawk Gunship, Legion" publicationId="ca571888--pubN80998" page="73" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="b1f9-a0fa-7bb1-5ce1" name="Legion Thunderhawk Gunship" publicationId="ca571888--pubN80998" page="88" hidden="false" typeId="56656869636c6523232344415441232323" typeName="Vehicle">
          <modifiers>
            <modifier type="set" field="5265617223232344415441232323" value="12">
