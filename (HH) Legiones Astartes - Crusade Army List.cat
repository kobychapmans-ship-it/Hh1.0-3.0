      <rules>
        <rule id="8ea2-1d5a-604b-15b9" name="Brutal Charge" publicationId="ca571888--pubN68042" page="233" hidden="false">
          <description>Inflicts D3 Hammer of Wrath attacks on the charge</description>
        </rule>
        <rule id="c1f3-74ba-2b87-e32d" name="Living Icon of the Legion" publicationId="ca571888--pubN68042" page="233" hidden="false">
          <description>Units with the Legiones Astartes (Ultramarines) with at least one model within 12" of Honoured Telemachus gain 1 to their Assault Resolution score and add 1" to their sweeping advance rolls.</description>
        </rule>
        <rule id="9b6e-0620-9506-8945" name="Resiliant" publicationId="ca571888--pubN68042" page="233" hidden="false">
          <description>Whenever he suffers a Penetrating hit, the owning player may ask the opponent to re-roll the result on the vehicle damage or destroyer damage charts.</description>
        </rule>
        <rule id="ab6a-f6eb-8b5d-a21b" name="Wrath in Betrayal" publicationId="ca571888--pubN68042" page="233" hidden="false">
          <description>Confers Hatred (Traitor Legiones Astartes) rule, which applies to all units from Traitor Legiones Astartes forces.</description>
        </rule>
      </rules>
