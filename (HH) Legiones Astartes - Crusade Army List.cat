        <profile id="47e6-626e-8d1e-7b7e" name="Cassian Dracos" publicationId="ca571888--pubN89821" page="252" hidden="false" typeId="57616c6b657223232344415441232323" typeName="Walker">
          <characteristics>
            <characteristic name="WS" typeId="575323232344415441232323">6</characteristic>
