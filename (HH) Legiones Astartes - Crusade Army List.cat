            <characteristic name="S" typeId="5323232344415441232323">4</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">4</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">2/1</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">5/4</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">2/1</characteristic>
