            <infoLink id="8720-86e5-9a8e-c80d" name="Obsidian Forged" hidden="false" targetId="e508-0571-af75-d25c" type="rule" />
            <infoLink id="3c24-8b6c-c3f0-b1ee" name="Fast" hidden="false" targetId="f4f1-8772-1a1b-4f50" type="rule">
