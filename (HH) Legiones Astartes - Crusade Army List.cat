      <rules>
        <rule id="7928-1616-6f90-88bf" name="Thunderous Charge" publicationId="ca571888--pubN113187" page="34" hidden="false">
          <description>On any turn which he charges, he may ignore the effect of Unwieldy with his hammer.</description>
        </rule>
        <rule id="3f92-cefb-840f-076a" name="Warlord's Pride" publicationId="ca571888--pubN113187" page="34" hidden="false">
          <description>If Eidolon is a part of the army, he will always be the warlord unless Fulgrim is present. He does not roll on the Warlord Traits table, but instead uses his own unique trait.</description>
        </rule>
      </rules>
