              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">12"</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10*</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">3</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Salvo 3/6</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="9101-e657-9a00-098a" name="Luminiferous Resonator" hidden="false">
              <description>Strength value is compared to the target's Leadership instead of toughness. The weapon has no effect on vehicles or any model without a Leadership characteristic.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="35.0" />
          </costs>
        </selectionEntry>
