      </profiles>
      <rules>
        <rule id="594a-c6bb-b385-e3f2" name="Teleporter Assault" publicationId="ca571888--pubN113187" page="16" hidden="false">
          <description>Abaddon and any terminator-armoured unit which he joins before deployment may Deep Strike. Additionally, they may re-roll results on the mishap table.</description>
        </rule>
