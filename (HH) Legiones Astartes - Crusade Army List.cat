                    <profile id="1f2f-ade8-ebc6-e020" name="Banner of the Aquila" publicationId="ca571888--pubN89821" page="234" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
                      <modifiers>
                        <modifier type="set" field="hidden" value="true">
                          <conditions>
