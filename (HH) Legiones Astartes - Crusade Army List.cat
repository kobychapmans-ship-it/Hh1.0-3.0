      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="1390-7d8e-2769-6218" name="Nostraman Flay-whip" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c5af-ab04-6d4c-df39" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="abdb-2ce9-13ee-27be" type="max" />
          </constraints>
          <profiles>
            <profile id="4c7a-005c-8d18-618a" name="Nostraman Flay-whip" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Rending, Electro-charge, Web of Steel, Specialist Weapon</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="5dc8-575e-1aea-1a05" name="Electro-charge" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false">
              <description>Any model that suffers an unsaved wound from this weapon reduces its Initiative value to 1 until the end of its controlling player's next turn.</description>
            </rule>
            <rule id="5fd9-d513-35bb-acbe" name="Web of Steel" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false">
              <description>A model equipped with a melee weapon with this special rule may choose to forfeit all of its normal attacks in order to make a single attack against each enemy model from the unit that it is locked in combat with an within 2" of the wielder, using the Flay-whip's profile. If this option is used then the Electro-charge special rule cannot trigger from unsaved wounds.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="1690-2fb4-3324-2e55" name="Rending" hidden="false" targetId="8269-2cd6-9236-16e7" type="rule" />
            <infoLink id="f1da-e2d7-762c-179a" name="Specialist Weapon" hidden="false" targetId="7ee3-d437-bc44-3630" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="0800-99e6-b220-1819" name="The Devils Due" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a7d4-1486-2d19-bb38" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="51e8-2b02-5026-a22b" type="max" />
