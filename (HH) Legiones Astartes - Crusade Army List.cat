      <rules>
        <rule id="333f-1edf-addf-a47e" name="Warlord Trait: The Head-Taker" hidden="false">
          <description>IfHvarl Red-Blade is your army's Warlord, both he and any Legiones Astartes (Space Wolves) Infantry
units from his Detachment within r 2" have the Preferred Enemy (Infantry) special rule.</description>
        </rule>
      </rules>
