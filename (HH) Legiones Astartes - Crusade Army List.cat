    <profile id="a544-0b30-4b15-43ff" name="Cortex Designator" publicationId="ca571888--pubN89821" page="232" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">When a model with this wargear makes a successful shooting attack against an enemy unit, any automata in the same unit gain Preferred Enemy when targeting that same enemy unit until the end of the controlling player's current turn.  </characteristic>
      </characteristics>
    </profile>
    <profile id="6e80-170b-509c-fd64" name="Cyclone Missile Launcher (Frag)" publicationId="ca571888--pubN80998" page="92" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">48"</characteristic>
