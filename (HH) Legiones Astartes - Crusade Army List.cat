      <rules>
        <rule id="e047-8c02-ae9c-132d" name="Cunning Strategist" publicationId="ca571888--pubN68042" page="236" hidden="false">
          <description>While Remus Ventanus is alive, the opposing player has a -1 modifier to all reserve rolls and the owning player may re-roll any reserves rolls (failed or successful).</description>
        </rule>
        <rule id="e6c8-296a-60ce-c044" name="Warlord: Resoulte Planning" hidden="false">
          <description> oth Captain Remus and units with the Legiones Astartes (Ultramarines) special rule in an army with Remus Ventanus as its Warlord have the Stubborn special rule while they have at least one model within 3" of an objective.</description>
        </rule>
      </rules>
