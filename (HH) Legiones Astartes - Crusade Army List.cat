          <profiles>
            <profile id="70dc-bbd6-f126-de16" name="Pariah Flamer" publicationId="ca571888--pubN89821" page="222" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">3</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">5</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Assault 1, Overpressure</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="46f9-814e-eea8-a570" name="Overpressure" publicationId="ca571888--pubN89821" page="222" hidden="false">
              <description>A weapon with the overpressure rule may be fired at St 4 and with the Torrent and Gets Hot special rules.  May not be used during overwatch.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="7335-8108-ef29-2c48" name="Pariah Power Armour" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="dbf2-d8be-0406-b8d6" type="equalTo" />
