                  <rules>
                    <rule id="daf747c3-d695-8113-85cb-c1c5f550ca3a" name="Sacred Trust" publicationId="ca571888--pubN66500" page="191" hidden="false">
                      <description>In missions where victory points are scored for destroying units, if a Primus Medicae is within 6" of a friendly Space Marine infantry or jump infantry unit which is wiped out by the enemy, roll a D6.  On a 5 the player whose unit was destroyed also gains a Victory Point, as well as the enemy.</description>
                    </rule>
                  </rules>
