    <profile id="b8643d20-d7ef-7974-7261-11c7b9787be0" name="Hyperios Missile Launcher" publicationId="ca571888--pubN80998" page="44" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
