    <selectionEntry id="37ee-c4c3-9905-0174" name="Dominator Cohort" publicationId="db9a-ae25-9e59-7f3f" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition field="selections" scope="force" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a5b8-cb5e-952f-3d3e" type="equalTo" />
                <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f3ce-93fe-445b-b5aa" type="equalTo" />
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4202-af28-aa59-b10b" type="max" />
      </constraints>
      <rules>
        <rule id="60b6-792b-88d4-5d33" name="Those Once Honoured" hidden="false">
          <description>A Dominator Cohort may be chosen instead of a Command Squad as a bodyguard for Perturabo. If selected in this manner they count as a Retintue unit and do not use up a separate Force Organisation slot, but no other Retinue unit may be selected for Perturabo. All model in a Dominator Cohort selected in this manner lose the Hatred (Cybernetica Cortex) and instead gain the Feel No Pain (6+) special rule. In adition, if an army includes a Domitar Cohort selected as a retinue for Perturabo, then the army may not include any 'Iron Circle' Domitar-ferrum class battle-automata maniple units.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4d36-a633-50ec-ebf1" name="Implacable Advance" hidden="false" targetId="5ecb-551d-0f68-3a79" type="rule" />
        <infoLink id="c6a4-46d0-cf43-470e" name="Stubborn" hidden="false" targetId="7be5-30af-1a02-0a89" type="rule" />
        <infoLink id="003c-9628-14b6-2c95" name="Hatred" hidden="false" targetId="7c6c-4e25-e4d4-9728" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Cybernetica Cortex)" />
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="37ee-c4c3-9905-0174" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c317-0f8c-791f-4a0b" type="equalTo" />
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink id="3151-0c24-be94-1bad" name="Feel No Pain (6+)" hidden="false" targetId="85da-2f19-3756-44de" type="rule">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="37ee-c4c3-9905-0174" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c317-0f8c-791f-4a0b" type="equalTo" />
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
      </infoLinks>
