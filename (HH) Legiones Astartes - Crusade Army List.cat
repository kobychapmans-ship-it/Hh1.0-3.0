      </constraints>
      <profiles>
        <profile id="14e4-34a4-32dd-401a" name="Kontos Power Lance" publicationId="ca571888--pubN103311" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Melee</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">7/User</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">2/4</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Two-Handed, Sunder*, Cumbersome, Murderous Strike*, Concussive*</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="2bd0-1acd-667c-4d23" name="Kontos Power Lance" hidden="false">
          <description>User the first profile on the turn that the model charged, including the Sunder, Murderous Strike and Concussive rules. If not use the second profile listed.</description>
        </rule>
        <rule id="8303-d668-2b56-88eb" name="Cumbersome" publicationId="ca571888--pubN103311" page="219" hidden="false">
          <description>A weapon with this type may only ever make a single attack in any given Assault phase. However, on a turn in which the bearer has charged, that attack is automatically made at Initiative step 10.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="67d0-8f84-8d71-b9d8" name="Murderous Strike" hidden="false" targetId="b0c5-b980-95e5-b181" type="rule" />
