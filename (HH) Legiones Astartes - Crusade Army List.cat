          <rules>
            <rule id="d406-1927-6bd7-aae5" name="The Kharash" publicationId="ca571888--pubN103311" page="220" hidden="false">
              <description>A unit with this special rule never counts as a scoring unit, however the enemy player may never score any Victory points for the destruction of a unit with this special rule regardless of the scenario played or any victory conditoins in effect. In addition, a unit with this special rule may not be joined by any model that does not also have the Kharash special rule.</description>
            </rule>
          </rules>
