              </profiles>
              <rules>
                <rule id="3962-762d-b7ff-4264" name="Geo-locator Beacon" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Units arriving via Deep Strike which are part of the force containing the Damocles do not scatter if they choose to arrive within 24"</description>
                </rule>
                <rule id="17ba-6cef-154a-3acb" name="Command Vox Relay" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Allows the controlling player to add a 1 or -1 modifer to reserve rolls while in play.  Additionally, enemy models suffer a 1 to Deep Strike Mishap table rolls.</description>
                </rule>
                <rule id="d1c9-29ba-0150-bad2" name="Focused Bombardment" publicationId="ca571888--pubN68042" page="237" hidden="false">
                  <description>Once per game, may call down a bombardment in the shooting phase.  May not move in the turn it shoots this weapon.</description>
                </rule>
              </rules>
