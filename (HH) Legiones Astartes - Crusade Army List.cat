      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="maxInRoster" type="max" />
      </constraints>
      <profiles>
        <profile id="9a85-8214-0dfb-00d3" name="Lorgar" publicationId="ca571888--pubN113187" page="78" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">6</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">6</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">6</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">6</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">5</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">6</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">4</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="7214-d88a-4354-a4d9" name="The Armour of the Word" publicationId="ca571888--pubN113187" page="79" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 4+ Invulnerable save, increasing to a 3 against psychic attacks, including Witchfire attacks and Force Weapons. </characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="9e5f-63fe-5573-b2fa" name="Sire of the Word Bearers" publicationId="ca571888--pubN113187" page="79" hidden="false">
          <description>Lorgar confers Crusader to any unit he joins.  Additionally, while Lorgar is present and not in a transport, all models with Legiones Astartes (Word Bearers) may use Lorgar's leadership for all Morale Checks and Pinning tests.</description>
        </rule>
        <rule id="8c53-a756-f20b-acdf" name="Living Icon" publicationId="ca571888--pubN113187" page="79" hidden="false">
          <description>All models in the same detachment with Legiones Astartes (Word Bearers) who can draw line of sight to Lorgar gain 1 to their charge distance rolls, are immune to Fear and add 1 to their total score when determining assault results</description>
        </rule>
        <rule id="13d9-b4f0-9f95-e265" name="Dark Fortune" publicationId="ca571888--pubN113187" page="79" hidden="false">
          <description>Lorgar may re-roll any Deny the Witch rolls.  In addition, once per game Lorgar may force a single enemy model or unit to re-roll all rolls of 5, 6, or both To Hit and To Wound against Lorgar in a given player turn. This must be declared before any rolls are made.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="a30d-75c4-914e-aa7a" name="New InfoLink" hidden="false" targetId="38d5-b6eb-bda8-2497" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="2395-b7b7-df46-1381" name="New CategoryLink" hidden="false" targetId="a2ba-16b0-8590-b017" primary="false" />
