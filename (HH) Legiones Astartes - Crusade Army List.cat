    <selectionEntry id="10ae-e160-077e-eaab" name="Fulgrim the Illuminator" publicationId="ca571888--pubN113187" page="36" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
