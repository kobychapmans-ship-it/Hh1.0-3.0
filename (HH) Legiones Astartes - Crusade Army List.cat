  <forceEntries>
    <forceEntry id="4e06-f510-5de0-195b" name="Armies of Dark Compliance" hidden="false">
      <modifiers>
        <modifier type="increment" field="d5e4-e9ea-df52-acd7" value="1.0">
          <conditions>
            <condition field="selections" scope="ancestor" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="c1d8-4cbf-e883-4e44" type="instanceOf" />
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d5e4-e9ea-df52-acd7" type="max" />
      </constraints>
      <rules>
        <rule id="cc25-0704-2c85-ff7d" name="Disposable" hidden="false">
          <description>The Disposable special rule given in the unit entry for the Inducted Levy Squad in the Imperialis Militia and Cults army list may be applied to any Militia unit in the army. Units that take this option never count as scoring or denial units. This Option should be declared at the same time as warlord traits, Psychic Powers, etc, are rolled for and if the option is not declared, the rule applies to only Inducted Levy Squads</description>
        </rule>
        <rule id="03ea-ee83-b8a7-6d8a" name="Warmaster's Due" hidden="false">
          <description>Any Model with the Legiones Astartes special rule that is part of this theme may claim a bonus of +1 to any cover saves granted because of weapon fire passing through any infantry units from the Imperialis Militia and Cults army list to reach them. However, if this bonus is claimed, the Militia unit immediately suffers D3 wounds per unit firing through them against which this save bonus has been claimed. Wounds inflicted in this way are distributed as if the enemy unit against which the cover save bonus has been claimed had fired upon the Militia unit, and have no AP value.</description>
        </rule>
      </rules>
      <categoryLinks>
        <categoryLink id="4e06-f510-5de0-195b-d27d-9e9b-d8c7-afe6" name="No Force Org" hidden="false" targetId="d27d-9e9b-d8c7-afe6" primary="false" />
        <categoryLink id="4e06-f510-5de0-195b-a91b-7f8f-d085-e564" name="HQ" hidden="false" targetId="a91b-7f8f-d085-e564" primary="false">
          <constraints>
            <constraint field="selections" scope="parent" value="3.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d1af-1ebc-a537-a8d1" type="max" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6814-aa6b-3031-af45" type="min" />
          </constraints>
        </categoryLink>
        <categoryLink id="4e06-f510-5de0-195b-7757-4995-3312-d330" name="Elites:" hidden="false" targetId="7757-4995-3312-d330" primary="false">
