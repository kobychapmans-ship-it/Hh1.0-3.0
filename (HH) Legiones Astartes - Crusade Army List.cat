    <selectionEntry id="8109-0da0-c572-2f4e" name="Domitar Class Battle-automata Maniple" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="add" field="category" value="6642-d5d5-95b3-9165">
          <conditions>
            <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3d4f-cf41-addc-d842" type="equalTo" />
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="6bb7-792b-1778-9f0a" name="Crusader*" publicationId="ca571888--pubN105292" hidden="false">
          <description>A unit that contains at least one model with this special rule rolls an extra dice when making Run moves, and uses the highest result rolled. In addition, a unit that contains at least one model with this special rule adds D3 to its Sweeping Advance totals (roll each time).

*Note that the unit must be in range of a Cortex Controller for this rule to take effect.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d388-3428-0ad8-0718" name="New InfoLink" hidden="false" targetId="d5cf-bd98-2854-13cf" type="rule" />
        <infoLink id="17cd-4174-b2a3-7b64" name="Brutal Charge" hidden="false" targetId="4927-560b-70be-12ee" type="rule" />
