                    <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Two-Handed, Instant Death, Master-Crafted, Wrath of Angels</characteristic>
                  </characteristics>
                </profile>
                <profile id="e92b-54a0-3749-7b0f" name="Moonsilver Blade" publicationId="ca571888--pubN103311" page="213" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                    <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
