        <selectionEntry id="9440-8d83-2cc1-1426" name="Ordo Reductor Minotaur" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b489-a0fa-9e3a-2e54" type="min" />
