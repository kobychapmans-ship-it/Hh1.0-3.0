      <rules>
        <rule id="fb81-13f1-8ced-020b" name="Fallen-star Pattern Power Spear" hidden="false">
          <description>*The first value is used on any turn in which the wielder has charged. The second value on turns in which the wielder has not charged.</description>
        </rule>
