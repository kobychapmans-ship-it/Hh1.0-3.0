      </constraints>
      <profiles>
        <profile id="bb6e-8f2e-0cc3-3090" name="Fulgrim the Illuminator" publicationId="ca571888--pubN113187" page="36" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">8</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">6</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">6</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">6</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">6</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">8</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">5</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="2643-be9c-c6a9-9ba8" name="The Gilded Panoply" publicationId="ca571888--pubN113187" page="37" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides a 2 armour and 5+ Invulnerable save.  In addition, should Fulgrim pass any armour or invulnerable save on a roll of a 6, the unit which inflicted the wound must take a Blind test.  </characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="0dba-3983-a685-4b89" name="Sire of the Emperor's Children" publicationId="ca571888--pubN113187" page="37" hidden="false">
          <description>Has the Crusader special rule, and must always accept and issues challenges in combat so long as a potential opponent in the challenge has WS 5 or higher.

In addtion, all units with the Legiones Astartes (Emperor's Children) rule (including Fulgrim) gain 2 to their combat resolution results, and any reserve rolls for the same units may be re-rolled, regardless if successful or not.</description>
        </rule>
        <rule id="fe49-133b-252d-f8e2" name="Sublime Swordsman" publicationId="ca571888--pubN113187" page="37" hidden="false">
          <description>In close combat, invulnerable save increases to 3.  In addition, in a challenge he gains a number of attacks equal to the difference between him as his opponent's initiative value.</description>
        </rule>
        <rule id="cb23-76bd-ff32-8486" name="Strategic Planning" publicationId="ca571888--pubN113187" page="37" hidden="false">
          <description>At the beginning of the game, a single Warlord Trait from either the Strategic Traits chart in the Warhammer 40,000 rulebook or the Legion Warlord Traits chart may be chosen for Fulgrim.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="39fb-fb39-ec0e-1b1c" name="Bulky" hidden="false" targetId="38d5-b6eb-bda8-2497" type="rule" />
      </infoLinks>
      <categoryLinks>
