      <rules>
        <rule id="f78af474-e39a-9f06-2851-e69c7968fde0" name="Unstoppable Charge" publicationId="ca571888--pubN113187" page="22" hidden="false">
          <description>May re-roll failed charge distances.</description>
        </rule>
        <rule id="e3367655-99a9-6983-dbef-00d1697356f6" name="Ravening Madmen" publicationId="ca571888--pubN113187" page="22" hidden="false">
          <description>Enemies always hit them on a 3 regardless of weapon skill.  May never be scoring regardless of the mission.</description>
        </rule>
