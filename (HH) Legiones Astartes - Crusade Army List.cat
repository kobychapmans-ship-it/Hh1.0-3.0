    <entryLink id="ac2ec963-7643-b51f-531d-3d3d1067efda" name="Anvillus Pattern Dreadclaw Drop Pod Unit" hidden="false" collective="false" import="true" targetId="9e7b-c091-5fd0-c846" type="selectionEntry">
      <modifiers>
