          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4c9e-9423-ed14-14d0" type="max" />
          </constraints>
          <profiles>
            <profile id="4046-209e-ffc9-daa7" name="Pariah Power Armour" publicationId="ca571888--pubN89821" page="222" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a +3 armour save that drops to a 5 against weapons with a Strength of 6 or higher whose AP is not sufficient to bypass the armour normally.  Models with this armour may Snap Shot with Pistol, Rapid Fire, and Assault weapons in the same Shooting phase in which they have Run, shooting once the movement is complete.  </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
