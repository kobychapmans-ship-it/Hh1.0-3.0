      <rules>
        <rule id="af92-4de2-92b5-3792" name="Order Exemplars" hidden="false">
          <description>Before the start of play each unit of Inner Circle Knights must be assigned an Order from the following list – the entire unit must be of the same Order:

In addition, such is the superlative skill of the Inner Circle Knights that they may make Overwatch attacks, despite being equipped with Cataphractii pattern Terminator armour</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6719-2f30-1dae-e163" name="Adamantium Will" hidden="false" targetId="df87-e991-2d30-dc38" type="rule" />
