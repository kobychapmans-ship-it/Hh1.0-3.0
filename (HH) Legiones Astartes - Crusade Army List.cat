        <profile id="a9d3-301b-6145-1eba" name="Argel Tal" publicationId="ca571888--pubN67636" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Unique, Jump Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">6</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">5</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">5</characteristic>
