          <profiles>
            <profile id="8033-70b7-c373-2e9c" name="The Death of Worlds" publicationId="690c-3e82-3080-6bc0" page="171" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+5</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Unwieldy, Curse of Dead Worlds. *Counts as a sword for the purpose of Mastery of the Blade</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="0df6-c995-18d5-dfed" name="Curse of Dead Worlds" publicationId="690c-3e82-3080-6bc0" page="171" hidden="false">
              <description>Invulnerable saves taken against hits inflicted by this weapon are reduced by -1, to a minimum of 6+ (for example, a model with a 4+ Invulnerable save struke by the Death of Worlds takes an Invulnerable save of only 5+ against the attack).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="036c-1bd0-6637-47e7" name="Unwieldy" hidden="false" targetId="5eea-958c-d623-c3c9" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
