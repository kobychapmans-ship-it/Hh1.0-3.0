          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile id="e35d-bf8d-f7e9-6aac" name="Mastadon" publicationId="ca571888--pubN89821" page="242" hidden="false" typeId="56656869636c6523232344415441232323" typeName="Vehicle">
          <modifiers>
            <modifier type="set" field="485023232344415441232323" value="15">
              <conditions>
                <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="c859-6b16-c533-7e97" type="equalTo" />
              </conditions>
            </modifier>
          </modifiers>
          <characteristics>
            <characteristic name="BS" typeId="425323232344415441232323">4</characteristic>
            <characteristic name="Front" typeId="46726f6e7423232344415441232323">14</characteristic>
            <characteristic name="Side" typeId="5369646523232344415441232323">14</characteristic>
            <characteristic name="Rear" typeId="5265617223232344415441232323">14</characteristic>
            <characteristic name="HP" typeId="485023232344415441232323">10</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Super-Heavy</characteristic>
          </characteristics>
        </profile>
        <profile id="b7f0-d9dc-db0c-652f" name="Mastadon" publicationId="ca571888--pubN89821" page="242" hidden="false" typeId="307d-047f-ca13-706b" typeName="Transport">
          <characteristics>
            <characteristic name="Capacity" typeId="8285-4205-b6cd-8473">May carry 40 models. It may also carry up to two Legion Dreadnoughts or Contemptor Dreadnoughts as part of its complement, each Dreadnought counting as ten models respectively.</characteristic>
            <characteristic name="Fire Points" typeId="b270-a7f9-22b2-3702">None</characteristic>
            <characteristic name="Access Points" typeId="d17b-0342-b1dc-b8e7">Front and Rear hatch.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="798d-f94d-a0c2-b58e" name="Enhanced Defensive Fire" publicationId="ca571888--pubN89821" page="242" hidden="false">
          <description>So long as at least one unit occupies the Mastadon, the Mastadon may use Overwatch fire with its sponson-mounted weapons when assaulted.  When this is the case, each sponson may be fired once per Assault phase.  Lascannons are fired at BS2 and Heavy Flamers inflict D31 automatic hits.</description>
        </rule>
        <rule id="cf95-f47e-4519-9fab" name="Reinforced Shell" publicationId="ca571888--pubN89821" page="242" hidden="false">
          <description>If destroyed, reduce the rolls on the Catastrophic damage table by -2.  If this results in a "0" or "-1" it does not explode but becomes a broken shell.  While still counted as destroyed, any models within suffer a S4 hit (vehicles hit on weakest armour value).  From this point on, it is treated as a ruined building rather than vehicle wreck, with its two doorways acting as open access points to the interior.</description>
        </rule>
        <rule id="36c2-59d8-be7d-d89d" name="Void Shields (2)" publicationId="ca571888--pubN89821" page="242" hidden="false" />
        <rule id="9193-44cf-6431-d01e" name="Crushing Weight" hidden="true">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditions>
                <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="c859-6b16-c533-7e97" type="equalTo" />
              </conditions>
            </modifier>
          </modifiers>
          <description>add +1 to all rolls on the Thunderblitz table when making a Ram or Tank Shock attack.�</description>
        </rule>
      </rules>
