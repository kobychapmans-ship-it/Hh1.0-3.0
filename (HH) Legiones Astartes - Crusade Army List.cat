        <rule id="a339-d2cb-ff60-e96e" name="Venerable" publicationId="ca571888--pubN113187" page="32" hidden="false">
          <description>May force results on the Vehicle Damage chart to be re-rolled. If this is done, the second result applies, even if it is worse than the first!</description>
        </rule>
        <rule id="388a-9397-2b3e-5715" name="Mantle of Glory" publicationId="ca571888--pubN113187" page="32" hidden="false">
          <description>Units with Legiones Astartes (Emperor's Children) on the same side as Rylanor within 24" may re-roll failed Morale Checks and add 1 to combat results.</description>
        </rule>
      </rules>
