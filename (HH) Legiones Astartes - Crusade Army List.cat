    <profile id="0d8bdd64-39f0-7759-d8ca-0702ee1f0fd0" name="Iliastus Assault Cannon" publicationId="ca571888--pubN113187" page="97" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic>
        <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
        <characteristic name="Type" typeId="5479706523232344415441232323">Heavy 4, Rending, Malfunction</characteristic>
      </characteristics>
    </profile>
    <profile id="b4c9d27d-b3cf-28bd-3367-b1bfddd5c401" name="Illum Flares" publicationId="ca571888--pubN80998" page="90" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May drop a single flare per turn.  Fired just as bombs - flare is placed after scattering.  Leave in place until the end of the turn.  Any unit targeting an enemy within 12" of the flare gains Night Vision for the shooting phase.  Split fire does not apply.  </characteristic>
      </characteristics>
    </profile>
    <profile id="dae18398-f03c-63ac-5477-470244e1e687" name="Kraken Bolt Shells" publicationId="ca571888--pubN80998" page="85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="52616e676523232344415441232323">30"</characteristic>
        <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
        <characteristic name="Type" typeId="5479706523232344415441232323">Rapid Fire</characteristic>
      </characteristics>
    </profile>
    <profile id="e2c7-737b-825e-7488" name="Lascarbine/Autogun" publicationId="ca571888--pubN89821" page="222" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
