      <rules>
        <rule id="6b02-3062-1361-79ce" name="Burning Lore" publicationId="ca571888--pubN113187" page="73" hidden="false">
          <description>Upgrade turns the model into a Level 1 Psyker with access to the Biomancy or Telepathy discipline.</description>
        </rule>
        <rule id="bb74-e4e7-c319-ae99" name="Warlord: Intimidating Presence" hidden="false">
          <description>All enemy units within 12" of High Chaplain Erebus must use their lowest Leadership value, not their highest.</description>
        </rule>
