      <selectionEntryGroups>
        <selectionEntryGroup id="f5d2-5fe4-d5cf-242b" name="Psychic Power" hidden="false" collective="false" import="true" defaultSelectionEntryId="6e74-fcf5-8c5e-b7aa">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2372-e3b0-7aa8-a008" type="max" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="328d-3300-e178-9e47" type="min" />
          </constraints>
          <selectionEntries>
            <selectionEntry id="6e74-fcf5-8c5e-b7aa" name="Lorgar Transfigured" page="0" hidden="false" collective="false" import="true" type="upgrade">
              <rules>
                <rule id="f7c1-eb70-4e49-2938" name="Lorgar Transfigured" publicationId="ca571888--pubN68042" page="255" hidden="false">
                  <description>Lorgar is a Level 3 Psyker who may select rather than roll three powers in any combination from Divination and Telekinesis disciplines at the start of the game.  When manifesting powers, Lorgar harnesses warp charges on a 3 instead of a 4.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="75.0" />
              </costs>
            </selectionEntry>
            <selectionEntry id="c4a9-d9ef-c1bc-2914" name="Erratic Psychic Power" hidden="false" collective="false" import="true" type="upgrade">
              <rules>
                <rule id="119c-489e-5ad9-9e2e" name="Erratic Psychic Power" hidden="false">
                  <description>Lorgar is a Level 2 Psyker who may choose to roll powers from either the Divination or Telekinesis Disciplines. When wishing to manifest his powers, Lorgar successfully harnesses Warp Charge on rolls of 5 rather than 4 as would normally be the case.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="0.0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
