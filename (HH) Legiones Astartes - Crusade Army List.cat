        <rule id="1a7c-041c-2b52-e46e" name="Harsh Taskmaster" publicationId="ca571888--pubN113187" page="84" hidden="false">
          <description>All units with Legiones Astartes (Iron Warriors) may use his leadership for Morale checks.</description>
        </rule>
        <rule id="2537-f315-f8a9-0438" name="Brutal Charge" publicationId="ca571888--pubN113187" page="84" hidden="false">
          <description>Golg and any Terminator-armoured models in a unit that he joins gain Hammer of Wrath</description>
        </rule>
        <rule id="3f72-3f45-f877-b0a7" name="Terminator Attack" publicationId="ca571888--pubN113187" page="84" hidden="false">
          <description>Legion Terminator Squads may be taken as Troops in an army with Golg as the Warlord</description>
        </rule>
        <rule id="331e-e070-1430-9ed2" name="Warlord: Bloody-handed" hidden="false">
          <description>If Golg is your army’s Warlord, he does not roll on the Warlord Traits table, but instead receives the Bloody-handed trait.</description>
        </rule>
      </rules>
