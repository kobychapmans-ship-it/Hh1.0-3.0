            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d6d1-28cb-f160-b7c2" type="min" />
          </constraints>
          <profiles>
            <profile id="2b10-a96b-8dbb-abd7" name="Psyfire Serpenta" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">15"</characteristic>
