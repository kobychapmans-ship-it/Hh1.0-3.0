          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323" />
          </characteristics>
        </profile>
        <profile id="246e-410a-5133-d316" name="The Auric Armour" publicationId="ca571888--pubN113187" page="103" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 4+ Invulnerable save. Additionally, no attack may wound Rogal Dorn on better than a 3 regardless of its Strength or special rules.  D weapons not affected. </characteristic>
          </characteristics>
        </profile>
        <profile id="b470-f4ce-9548-30c7" name="Storm's Teeth" page="" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Shred, Rampage, Reaping Blow</characteristic>
          </characteristics>
        </profile>
        <profile id="5874-3916-7268-e532" name="The Voice of Terra" publicationId="ca571888--pubN113187" page="103" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic>
