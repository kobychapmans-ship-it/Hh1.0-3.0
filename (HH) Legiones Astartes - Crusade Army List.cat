        <characteristic name="Type" typeId="5479706523232344415441232323">Heavy 1, Sunder, One-shot</characteristic>
      </characteristics>
    </profile>
    <profile id="16f6-887b-504f-56da" name="Hellstrike Missiles" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
