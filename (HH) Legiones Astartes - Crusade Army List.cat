      <selectionEntries>
        <selectionEntry id="83e6-df29-4ccd-8ab5" name="Terrax Pattern Termite Assault Drill" page="https://www.forgeworld.co.uk/resources/PDF/Downloads//Terrax_Termite_Legiones_Astartes.pdf" hidden="false" collective="false" import="true" type="upgrade">
