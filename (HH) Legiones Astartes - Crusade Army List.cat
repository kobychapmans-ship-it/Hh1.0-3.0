      <profiles>
        <profile id="765f-5a8c-a822-78e9" name="Sokar Pattern Stormbird" publicationId="ca571888--pubN68042" page="217" hidden="false" typeId="56656869636c6523232344415441232323" typeName="Vehicle">
          <characteristics>
            <characteristic name="BS" typeId="425323232344415441232323">4</characteristic>
            <characteristic name="Front" typeId="46726f6e7423232344415441232323">14</characteristic>
            <characteristic name="Side" typeId="5369646523232344415441232323">13</characteristic>
            <characteristic name="Rear" typeId="5265617223232344415441232323">12</characteristic>
            <characteristic name="HP" typeId="485023232344415441232323">12</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Super-heavy Flyer (Hover, Transport)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="270c-043c-c36a-cf9e" name="Shield Projection" publicationId="ca571888--pubN68042" page="217" hidden="false">
          <description>So long as the Sokar is in Hover mode and remains stationary, it may declare that it is projecting its void shields at the start of their turn.  They extend 12" from the main hull and wings.</description>
        </rule>
        <rule id="9e52-9184-6a0e-2560" name="Reinforced Structure" publicationId="ca571888--pubN68042" page="217" hidden="false">
          <description>Confers a 5+ Invulnerable against any attacks that have breached its void shields.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="dd60-9f73-3a4c-9633" name="Assault Vehicle" hidden="false" targetId="45cf-653a-4ff6-f22d" type="rule" />
