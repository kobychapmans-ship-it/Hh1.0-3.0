        <profile id="7ef6-2d10-39a3-a6e4" name="Enhanced Ferromantic Rites" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Land Raider Achilles-Alpha is not subject to the effects of the Melta and Lance special rules by attacks made against it.  In addition it reduces the effects of all rolls on the damage chart by -1 (except Destroyer hits).</characteristic>
          </characteristics>
        </profile>
