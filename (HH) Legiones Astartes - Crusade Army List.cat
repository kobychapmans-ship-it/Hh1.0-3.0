            <profile id="365a-e5fb-b92b-14b5" name="The Cataphractii Primus" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">In addition to the standard rules for this armour type, the wearer gains the Eternal Warrior special rule and adds 1 to their Toughness characteristic against Shooting attacks.</characteristic>
