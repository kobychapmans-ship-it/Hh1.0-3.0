          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">8</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">5</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">7</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">6</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">6</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">6</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">5</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="2c27-ccb9-f4c5-54f4" name="Point of the Spear" page="0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Unlimited</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Ordnance 1, Large Blast, Lance, Twin-linked</characteristic>
          </characteristics>
        </profile>
        <profile id="4fd3-8ed6-2cb6-e867" name="The Serpent's Scales" page="0" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers 2+ save and a 3+ Invulnerable save, and negates and psychic attack or any effect that would adversely modify his characteristic profile on a 3</characteristic>
          </characteristics>
        </profile>
        <profile id="e41e-ade8-2ec6-a538" name="Worldbreaker" page="0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Master-crafted, Concussive, Unwieldy</characteristic>
          </characteristics>
        </profile>
        <profile id="8041-6f36-24a0-3531" name="The Warmaster's Talon (Claw)" page="0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">User</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Shred, Disabling Strike</characteristic>
          </characteristics>
        </profile>
        <profile id="422d-29e4-16dd-17ed" name="The Warmaster's Talon (Bolter)" page="0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">24"</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">5</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">3</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Assault 3, Twin-linked</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="3d83-13b2-8cc3-97b7" name="Weapon Mastery" page="0" hidden="false">
          <description>May wield two close combat weapons simultaneously, splitting his attacks with them in combat as desired.</description>
        </rule>
        <rule id="f210-d84e-4b57-91ff" name="Sire of the Sons of Horus" page="0" hidden="false">
          <description>When fighting a unit or character with WS 4 or less, he gains D3 attacks.  If he (any any terminator-armoured unit he joins) are in reserve, the player may choose what turn he arrives instead of rolling normally.</description>
        </rule>
        <rule id="606d-b834-d84a-957a" name="God of Battle" page="0" hidden="false">
          <description>- Any part of a force containing Horus in reserve gains Outflank
- All models with Legiones Astartes (Sons of Horus) gain 1 Ld to a max of 10
- May seize the initiative on a 4</description>
        </rule>
        <rule id="1ce5-0fcf-58c2-2081" name="Point of the Spear" page="0" hidden="false">
          <description>- Veteran Tactical squads and Justaerin Terminator squads may be taken as troops when Horus is the Warlord
- When not engaged in close combat or in reserve, Horus may call down a shooting attack once per game.</description>
        </rule>
        <rule id="8dac-642a-d663-2f68" name="Disabling Strike" page="0" hidden="false">
          <description>Any model that is wounded but not killed by The Warmasters Talon in an assault loses -1 WS and -1 Str for the remainder of the game.  This is cumulative.</description>
        </rule>
        <rule id="a5aa-7354-fc0d-41e8" name="Teleportation Matrix" page="0" hidden="false">
          <description>The Warmaster and any attached terminator-armoured unit will not scatter when entering by Deep Strike</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8efc-d0a5-127f-3612" name="New InfoLink" hidden="false" targetId="abc9-8566-bb61-4b7c" type="rule" />
        <infoLink id="b076-1ed9-1267-8e88" name="Night Vision" hidden="false" targetId="f2ea-6534-0b19-3252" type="rule" />
