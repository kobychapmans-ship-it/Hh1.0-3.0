    <selectionEntry id="8a6d-1cc1-8aca-5a5a" name="Master of Armour" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="7358-de21-3ee3-1c8b" value="0">
          <conditions>
