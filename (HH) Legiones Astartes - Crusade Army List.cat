          <profiles>
            <profile id="993a-6601-7868-6be8" name="The Devils Due" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">+2</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">2</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Unwieldy, The Devil's Due, Muderous Strike, Master-crafted</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="c59f-4727-6575-b9e6" name="The Devils Due" publicationId="690c-3e82-3080-6bc0" page="184" hidden="false">
              <description>If an enemy model in base contact with this model has its Initiative value reduced by the effects of any other weapon of special rule then this model may make a single additional attack against the enemy model. This additional attack is make Immediatly before the enemy model would attack and uses the profile for the Devil's Due shown above.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="9c49-00d9-cd9c-25f0" name="Unwieldy" hidden="false" targetId="5eea-958c-d623-c3c9" type="rule" />
            <infoLink id="8a99-4722-a92c-c91c" name="Murderous Strike" hidden="false" targetId="b0c5-b980-95e5-b181" type="rule" />
            <infoLink id="379a-bc17-8df8-067e" name="Master-crafted" hidden="false" targetId="f899-8f9d-fc7e-d855" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="0.0" />
          </costs>
        </selectionEntry>
