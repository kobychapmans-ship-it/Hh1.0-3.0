          </characteristics>
        </profile>
        <profile id="3a60-bf2d-81bf-57ef" name="Azurda Char'is" publicationId="ca571888--pubN68042" page="250" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">2</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Force, Two-handed</characteristic>
          </characteristics>
        </profile>
        <profile id="4829-d941-0088-5c53" name="Panoply of Flame" publicationId="ca571888--pubN68042" page="250" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">All models with Legiones Astartes (Word Bearers) rule within 12" add a 1 modifier for combat resolution and sweeping advance rolls.  Additionally in lieu of making one of Layak's normal shooting attacks, the Panoply may be used as if it were a Heavy Flamer once per game. </characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="438f-355e-951e-aba6" name="Zardu Layak" hidden="false" />
        <rule id="d8a3-9e68-067d-eda6" name="Psyker Level 2" publicationId="ca571888--pubN84656" hidden="false">
          <description>Psyker (Mastery Level 2) Zardu Layak may only generate psychic powers from the Pyromancy or Daemonology – Malefic Powers disciplines.</description>
        </rule>
        <rule id="687d-74ba-73b8-d074" name="Binder of Souls" publicationId="ca571888--pubN68042" page="250" hidden="false">
          <description>Counts as a Diabolist.  In addition, units in an army containing Layak may benefit from the Dark Channelling special rule with a 1 modifier on the Dark Channelling table.  If an army has Layak as its Warlord, then it may take an allied detachment from Codex: Chaos Daemons.</description>
        </rule>
        <rule id="1773-680b-c710-c5d0" name="Warlord: Reign of Fire" hidden="false">
          <description>If Zardu Layak is the army’s Warlord, then Ashen Circleunits may be taken as Troops choices for the army’s primarydetachment instead of Fast Attack choices and becomes a scoring unit. In addition, if taken, these units must be given the Dark Channelling upgrade at a cost of 25 points per squad.</description>
        </rule>
      </rules>
      <infoLinks>
