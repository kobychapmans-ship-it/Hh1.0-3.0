          </characteristics>
        </profile>
        <profile id="a829-1063-4a97-3945" name="Dreadfire Heavy Flamers" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">May be fired as two individual heavy flamers or as a single twin-linked meltagun.  Must be made prior to shooting phase.  If one heavy flamer is destroyed, this option is lost.  These weapons benefit from the Legiones Astartes (Salamanders) special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="89a6-6544-28df-f293" name="Wrought by Vulkan" publicationId="ca571888--pubN89821" page="252" hidden="false">
          <description>Immune to effects of Melta, Armourbane, Sunder, and Lance rules.  Any other rules which reduce or permantly degrade his Armour or allow attacks targeting him to roll more than one dice when making Armour penetration rolls have no effect.</description>
        </rule>
        <rule id="0db0-f0ca-9973-ffdd" name="Venerable" hidden="false" />
        <rule id="35db-4e11-b193-46c2" name="Burning Wrath" publicationId="ca571888--pubN89821" page="252" hidden="false">
          <description>May forfeit his normal number of close combat attacks to inflict one automatic S6 AP4 hit at initiative 1 on every model in base contact, friendlies included.</description>
        </rule>
        <rule id="915f-f518-b4e6-9650" name="Avatar of the Sacred Flames" publicationId="ca571888--pubN89821" page="252" hidden="false">
          <description>May become the army's Warlord as long as no other HQ choices besides Xiaphas Jurr or Narik Dreygur are included. He does not roll for
his Warlord Trait but uses the Bloody Handed Warlord Trait.</description>
        </rule>
        <rule id="0b35-e697-7130-546d" name="The Voice of the Machine" publicationId="ca571888--pubN89821" page="252" hidden="false">
          <description>May use a single Cybertheurgy power (HH6 p280) per turn.  Uses Ld7 when attempting and may use only a select list.
When attempting to use a Cybertheurgy power, Cassian Dracos Reborn uses a Leadership of 7 and may only attempt to use one of the following powers: The Rite of Celerity, The Rite of Eternity, The Rite of Fury, or The Rite
of Rededication.</description>
        </rule>
      </rules>
