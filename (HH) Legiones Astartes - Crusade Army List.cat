            <profile id="6434-fc05-d7c3-6654" name="Legion Space Marine Sky Seeker" publicationId="690c-3e82-3080-6bc0" page="195" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
              <characteristics>
                <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Jetbike</characteristic>
                <characteristic name="WS" typeId="575323232344415441232323">4</characteristic>
