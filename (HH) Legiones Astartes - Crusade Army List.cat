    <selectionEntry id="2694-d50d-3de4-100d" name="Lorgar" publicationId="ca571888--pubN113187" page="78" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
