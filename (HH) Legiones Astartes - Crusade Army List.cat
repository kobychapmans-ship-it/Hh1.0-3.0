    <selectionEntry id="6b79-3571-1a67-313c" name="Kyr Vhalen" publicationId="ca571888--pubN113187" page="85" hidden="false" collective="false" import="true" type="model">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
