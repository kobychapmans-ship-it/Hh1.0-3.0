      <selectionEntries>
        <selectionEntry id="3023-69c8-2008-4f19" name="Warsmith" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3d16-20b1-8e9e-0f41" type="max" />
