    <selectionEntry id="43b9-000f-f59a-413a" name="Nemesis Ammunition (Bolter)" publicationId="18fc-e8f3-462f-9e60" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="e376-203e-910f-34a2" name="Nemesis Ammunition (Bolter)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">18"</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">5</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Assault 2, Harrower</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="eb64-dcb6-d4ed-4719" name="Harrower" hidden="false">
          <description>Any To Wound roll of a 6 is resolved at AP 2. Additionally, any unit from which a model is removed as a casualty during the Shooting phase as a result of an attack from a weapon with this special rule, must take a Morale check as if they had suffered 25% casualties.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0.0" />
      </costs>
    </selectionEntry>
