      <rules>
        <rule id="b5b5-5233-c054-0c8d" name="Broken in Body" publicationId="ca571888--pubN113187" page="14" hidden="false">
          <description>Maloghurst and any unit he joins may not make Run moves or Sweeping Advance.</description>
        </rule>
        <rule id="ec6d-c6ff-462e-eaf6" name="Bearer of the Eye" publicationId="ca571888--pubN113187" page="14" hidden="false">
          <description>If Maloghurst is present in a detachment, Veteran Tactical Squads and Reaver Squads may be taken as troops.</description>
        </rule>
      </rules>
