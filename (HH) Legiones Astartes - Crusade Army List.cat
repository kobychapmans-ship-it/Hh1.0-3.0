      <profiles>
        <profile id="3820-a7e9-7de3-2590" name="Xiaphas Jurr" publicationId="ca571888--pubN89821" page="255" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">5</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">5</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">4</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">4</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">2</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">5</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">3</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="52b8-f4ee-0684-db9a" name="Dragonscale Storm Shield" publicationId="ca571888--pubN113187" page="65" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Confers a 5+ Invulnerable save or increases existing invulnerable save by 1. May never claim the extra attack for having two close combat weapons.  </characteristic>
          </characteristics>
        </profile>
        <profile id="3a7a-9e2d-f058-e7e5" name="The Burning Halo" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">The Burning Halo provides a 4+ Invulnerable save, and if the bearer makes a successful invulnerable save against a close combat hit of Strength s or higher, all models in base contact with the bearer suffer a single Str 4 AP - hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="a64d-13ba-a085-4f5f" name="Prophet of the Flame" publicationId="ca571888--pubN89821" page="255" hidden="false">
          <description>Counts as a Psyker with Mastery Level 1 and Prescience and Precognition powers from the Divination Discipline.  However, uses Leadership 7 when making Psychic tests.</description>
        </rule>
        <rule id="da6c-5830-6eb3-db40" name="Warlord: Beacon of Hope" hidden="false">
          <description>Note that if Cassian Dracos is included in the same army as Xiaphas Jurr, then Xiaphas Jurr may not be selected as its Warlord.

As long as Xiaphas Jurr has not been removed from play as a casualty and is not held in Reserve or embarked on a Transport vehicle, his controlling player may re-roll the first failed Pinning test or Morale check of each Game Turn.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="258f-65a9-728d-c049" name="Independent Character" hidden="false" targetId="3ad4-1c37-d60b-1a4e" type="rule" />
        <infoLink id="171c-93b0-bec0-42e9" name="Zealot" hidden="false" targetId="e300-69f2-111a-ed55" type="rule" />
