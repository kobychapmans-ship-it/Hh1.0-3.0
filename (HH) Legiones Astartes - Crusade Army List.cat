      <profiles>
        <profile id="dfc5-891e-18dd-83b0" name="Konrad Curze" publicationId="690c-3e82-3080-6bc0" page="190" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Jump Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">8</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">6</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">6</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">6</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">6</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">7</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">5</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="ad3f-19f6-a29e-d50b" name="The Nightmare Mantle" publicationId="690c-3e82-3080-6bc0" page="190" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides a 2+ armour save and a 4+ Invulnerable save, and grants the Hit and Run special rule. When the Night Haunter charges, he gains the Hamer of Wrath special rule, inflicting D3 Hammer of Wrath attack rather than the usual +1 additional attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="afe4-f587-e1bb-0aff" name="Sire of the Night Lords" publicationId="690c-3e82-3080-6bc0" page="190" hidden="false">
          <description>Has Night Vision and Acute Senses and may always elect to have Night Fighting for the first game turn. All units with Legiones Astartes (Night Lords) gain Fear and impose a -1 penalty to enemy units taking fear checks.</description>
        </rule>
        <rule id="07e2-8d64-37c9-887e" name="The King of Terrors" publicationId="690c-3e82-3080-6bc0" page="190" hidden="false">
          <description>Fear tests from Kurze are made at a -3 penalty.  Additionally, if Kurze is part of an assault where any enemy unit is wiped out, any units within 12" that are subject to Fear must take an immediate Morale check or fall back</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="94a7-aea0-2c05-4de4" name="Murderous Strike" hidden="false" targetId="b0c5-b980-95e5-b181" type="rule" />
