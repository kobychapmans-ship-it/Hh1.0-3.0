          <rules>
            <rule id="c05c-c9a4-61eb-0931" name="Severing Cut" publicationId="ca571888--pubN68042" page="253" hidden="false">
              <description>On any To Wound rolls of a 5 or 6, attacks from this weapon are treated as AP2 and each unsaved wound causes two wounds.</description>
