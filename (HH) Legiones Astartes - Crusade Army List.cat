      <rules>
        <rule id="8b05-04ba-3690-f9d6" name="Born Survivor" publicationId="ca571888--pubN113187" page="17" hidden="false">
          <description>The first time Loken is removed as a casualty, roll a D6.  On a 2 he lives on with a single wound remaining.  This rule can only be used once per battle.</description>
        </rule>
        <rule id="3c7d-ba05-eeb1-4a45" name="Warlord: Inspiring Presence" hidden="false">
          <description>Friendly units within 12" can use Loken’s Leadership value rather than their own.</description>
        </rule>
      </rules>
