      <profiles>
        <profile id="f26c-539f-853c-a0b9" name="Vulkan" publicationId="ca571888--pubN113187" page="68" hidden="false" typeId="556e697423232344415441232323" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="556e6974205479706523232344415441232323">Infantry (Character)</characteristic>
            <characteristic name="WS" typeId="575323232344415441232323">7</characteristic>
            <characteristic name="BS" typeId="425323232344415441232323">5</characteristic>
            <characteristic name="S" typeId="5323232344415441232323">7</characteristic>
            <characteristic name="T" typeId="5423232344415441232323">7</characteristic>
            <characteristic name="W" typeId="5723232344415441232323">6</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">5</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">4</characteristic>
            <characteristic name="LD" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
        <profile id="0e71-72c2-4c56-7e4d" name="The Draken Scale" publicationId="ca571888--pubN113187" page="69" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Provides 2 armour and 3+ Invulnerable save and halves (rounding down) the strength of any flamer, fusion, volkite, melta, or plasma weapon used against him. </characteristic>
          </characteristics>
        </profile>
        <profile id="8fe7-3d8f-21fe-fff1" name="Heavy Flamer (St 6)" publicationId="ca571888--pubN113187" page="68" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="52616e676523232344415441232323">Template</characteristic>
            <characteristic name="Strength" typeId="537472656e67746823232344415441232323">6</characteristic>
            <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
            <characteristic name="Type" typeId="5479706523232344415441232323">Assualt 1</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="aea4-7efc-ede6-c46a" name="Blood of Fire" publicationId="ca571888--pubN113187" page="69" hidden="false">
          <description>Vulkan may re-roll any failed It Will Not Die or Deny the Witch rolls.</description>
        </rule>
        <rule id="6fb6-3958-c48f-a3b2" name="Sire of the Salamanders" publicationId="ca571888--pubN113187" page="69" hidden="false">
          <description>All models with Legiones Astartes (Salamanders) gain 1 Leadership (to max 10) and Adamantium Will.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cae8-1fe3-1c22-db1a" name="Very Bulky" hidden="false" targetId="abc9-8566-bb61-4b7c" type="rule" />
      </infoLinks>
      <categoryLinks>
        <categoryLink id="afde-fdcc-5e62-bd7a" name="New CategoryLink" hidden="false" targetId="a2ba-16b0-8590-b017" primary="false" />
