    <profile id="f6de-b927-0fb9-5ad6" name="Djinn-sight" hidden="false" typeId="57617267656172204974656d23232344415441232323" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="4465736372697074696f6e23232344415441232323">Reduces enemy benefit from cover by -2. Additionally infiltrators may not be deployed within 24".</characteristic>
