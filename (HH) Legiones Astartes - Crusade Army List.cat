        <categoryLink id="43d6-e106-9a0e-20cb" name="Character" hidden="false" targetId="8ab2-4493-44a4-b282" primary="false" />
      </categoryLinks>
      <selectionEntries>
        <selectionEntry id="3426-74d2-90e4-21c1" name="Dawnbringer" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e56f-a757-e81c-6bf1" type="min" />
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fa42-2122-80b6-6999" type="max" />
          </constraints>
          <profiles>
            <profile id="9f88-7dd1-04ed-a713" name="Dawnbringer" publicationId="ca571888--pubN113187" page="69" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <modifiers>
                <modifier type="append" field="5479706523232344415441232323" value=", Master-Crafted">
                  <conditions>
                    <condition field="selections" scope="force" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="c859-6b16-c533-7e97" type="equalTo" />
                  </conditions>
                </modifier>
              </modifiers>
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">-</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">10</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">1</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Melee, Two-handed, Concussive, Armourbane, Instant Death, Earthshatter</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="a7c8-e5ff-c613-c725" name="Earthshatter" publicationId="ca571888--pubN113187" page="69" hidden="false">
              <description>Instead of attacking normally in an assault, Vulkan may instead place a Blast marker anyhwere in base contact that does not cover any friendly models. All models under the Blast suffer a single automatic Strength 8 AP 3 hit with the Strikedown rule.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="2f28-5596-e482-e38a" name="Concussive" hidden="false" targetId="9d85-46f7-f5e6-a5f7" type="rule" />
