    <selectionEntry id="a7a075f3-33fb-511e-a0eb-1fe3129e1091" name="Iron Hands Morlock Terminator Squad" hidden="false" collective="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="5f1928be-4981-5b34-ad21-db7a90660854" name="HQ" hidden="false" targetId="41898db8-ff03-56e1-82ec-a0b1eb33b28c" primary="true" />
