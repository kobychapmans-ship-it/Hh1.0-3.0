            <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="577a-07db-b7b2-3d13" type="min" />
          </constraints>
        </categoryLink>
        <categoryLink id="4e06-f510-5de0-195b-220b-7c51-58b3-6ac0" name="Troops" hidden="false" targetId="220b-7c51-58b3-6ac0" primary="false">
