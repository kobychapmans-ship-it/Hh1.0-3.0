                <selectionEntry id="407c-1865-67c0-809d" name="Mortificator" publicationId="ca571888--pubN103311" page="292" hidden="false" collective="false" import="true" type="upgrade">
                  <modifiers>
                    <modifier type="set" field="hidden" value="true">
                      <conditions>
