    <selectionEntryGroup id="2f76-536e-c871-231d" name="May be upgraded with one of the following augment upgrades:" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="b176-c59f-d025-4b19" type="max" />
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a8a2-faea-11ff-fec8" type="min" />
      </constraints>
      <selectionEntries>
        <selectionEntry id="6ce7-cbc0-365c-642b" name="Icarian" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0c9b-76b0-8cf5-e779" type="max" />
          </constraints>
          <rules>
            <rule id="a741-f2f1-86c2-3432" name="Icarian*" publicationId="ca571888--pubN66489" page="39" hidden="false">
              <description>If stationary that turn, the Cohort may, if wished, count as having the
                                        Skyfire special rule for all its ranged weapons that turn. Units with this
                                        augment count as a Heavy Support choice instead of a troops choice for the army.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="25.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="d48a-d06f-5332-ac4c" name="Ferrox" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f0a4-d8f5-1536-30cc" type="max" />
          </constraints>
          <rules>
            <rule id="1bdd-f228-3945-bbee" name="Ferrox" publicationId="ca571888--pubN66489" hidden="false">
              <description>The unit gains the Rage rule and its close combat attacks (regardless of type) gain the Rending special rule. The unit may not be upgraded to replace
their lightning guns.</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="25.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="6db2-d57d-8a51-089e" name="Destructor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="20a9-f5a3-606a-28f2" type="max" />
          </constraints>
          <rules>
            <rule id="773d-e185-66d6-8393" name="Destructor" publicationId="ca571888--pubN66489" page="39" hidden="false">
              <description>Gains Tank Hunters.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="3c57-d659-cf64-5d6b" name="Tank Hunters" hidden="false" targetId="5d88-bcf6-e410-6e01" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0" />
          </costs>
        </selectionEntry>
        <selectionEntry id="4977-f031-54c7-c153" name="Empyrite" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6546-49a8-2482-5ebc" type="max" />
          </constraints>
          <rules>
            <rule id="1540-6c92-1be0-d6a4" name="Empyrite" publicationId="ca571888--pubN66489" page="39" hidden="false">
              <description>The unit now uses the Deep Strike special rule via implanted
                                        teleporation units and also gains the Void Hardened special rule.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="a85d-a404-d66d-7786" hidden="false" targetId="d219-2314-4834-c054" type="rule" />
            <infoLink id="6e2a-7878-7d82-c4d7" name="Void Hardened" hidden="false" targetId="68a1-4a8b-c934-7fc0" type="rule" />
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="10.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
