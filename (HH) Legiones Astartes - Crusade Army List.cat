            <profile id="d6e97afa-0236-9c53-ce8e-7179be55f9f9" name="The Drakaina" publicationId="ca571888--pubN84158" page="227" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="52616e676523232344415441232323">12"</characteristic>
                <characteristic name="Strength" typeId="537472656e67746823232344415441232323">4</characteristic>
                <characteristic name="AP" typeId="415023232344415441232323">4</characteristic>
                <characteristic name="Type" typeId="5479706523232344415441232323">Pistol, Poisoned, Rending, Flesh-phage</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="6929-ff57-e53f-3198" name="Flesh-phage" hidden="false">
              <description>A unit which suffers one or more casualties from this weapon must take D6 Toughness tests at the start ot every subsequent Alpha Legion Shooting phase. Each tailed test results in a wound being sustained, with no saves of anv kind. This effect ceases should a Shooting phase pass without anv such wounds being sustained.
</description>
            </rule>
          </rules>
          <costs>
            <cost name="pts" typeId="points" value="45.0" />
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
