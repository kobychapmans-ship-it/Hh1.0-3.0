            <characteristic name="Save" typeId="5361766523232344415441232323">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="cd2a-0a1b-ed5f-c295" name="Warlord: Master of the Vakrah Jal" hidden="false">
          <description>An army whose Warlord has this Trait may select Gal Vorbak Dark Brethren units as Troops choices. In addition, while a Warlord with this Trait is part of a unit composed entirely of models with the Daemon special rule, the Warlord and all models in the unit it has joined gain the Feel No Pain special rule.</description>
        </rule>
        <rule id="9723-2ccb-536f-6deb" name="Master of the Legion*" hidden="false">
          <description>*Note that although Argel Tal does not have the Legiones Astartes (Word Bearers) special rule, an army that has him as its Warlord may still select Word Bearers Legion specific Rites of War.</description>
        </rule>
      </rules>
